rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: evenements
// Document ID: {eventId} (slug string, e.g., "sunwave-festival-3-jours")
// Visibility: Public read-only catalog (no PII). Managed by authenticated admins (listed in /admins) or Admin SDK.
// Fields (from assets/js/events-data.js):
//   - id: string (required) - Event slug identifier
//   - title: string (required) - Event display title
//   - category: string (required) - Category key (e.g., "festival", "concert", "theatre", "sport")
//   - catLabel: string (required) - Localized category label
//   - date: string (required) - Display date string
//   - lieu: string (required) - Venue name and city
//   - prix: number (required) - Base ticket price
//   - stock: number (required) - Remaining ticket count
//   - img: string (required) - Relative image asset path
//   - desc: string (required) - Event description
//   - tarifs: list<map> (required) - Ticket tiers ({ type: string, label: string, prix: number })
//
// Collection: users
// Document ID: {userId} (must match authenticated Firebase Auth request.auth.uid)
// Visibility: Private to the owning authenticated user only (contains PII).
// Fields:
//   - prenom: string (required, 1..100 chars) - User first name
//   - nom: string (required, 1..100 chars) - User last name
//   - email: string (required, 3..254 chars) - User email address
//   - tel: string (required, 0..40 chars) - User phone number (empty string if unset)
//   - adresse: string (required, 0..300 chars) - User postal address (empty string if unset)
//   - updatedAt: string (required, 1..64 chars) - ISO 8601 client update timestamp
//
// Collection: paniers
// Document ID: {userId} (must match authenticated Firebase Auth request.auth.uid)
// Visibility: Private to the owning authenticated user only.
// Fields:
//   - items: list<map> (required, max 50 items) - Cart line items
//   - promoCode: string (required, 0..32 chars) - Applied promo code (empty string if none)
//   - updatedAt: string (required, 1..64 chars) - ISO 8601 client update timestamp
//
// Collection: billets
// Document ID: {userId} (must match authenticated Firebase Auth request.auth.uid)
// Visibility: Private to the owning authenticated user only.
// Fields:
//   - items: list<map> (required, max 200 items) - Purchased ticket records
//   - updatedAt: string (required, 1..64 chars) - ISO 8601 client update timestamp
//
// Collection: admins
// Document ID: {userId} (must match authenticated Firebase Auth request.auth.uid)
// Visibility: Private to the owning authenticated user (get only). Provisioned server-side / Firebase Console only.
// Fields:
//   - Presence of document grants admin role for /evenements management.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the document keyed by userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the authenticated user has an admin role document in /admins
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Validate that the document contains all required fields
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Validate string type and length bounds
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Validate that a field is a list of maps within size limits
    // Note: CEL cannot iterate all elements of an arbitrary-length list,
    // so we enforce list type, max size, and verify the first element is a map when non-empty.
    function isValidMapList(listVal, maxSize) {
      return listVal is list &&
             listVal.size() <= maxSize &&
             (listVal.size() == 0 || listVal[0] is map);
    }

    // ===============================================================
    // Domain Validators (Used in both create and update)
    // ===============================================================

    function isValidUserProfile(data) {
      let allowed = ['prenom', 'nom', 'email', 'tel', 'adresse', 'updatedAt'];
      return hasRequiredFields(data, allowed) &&
             hasOnlyAllowedFields(data, allowed) &&
             isValidString(data.prenom, 1, 100) &&
             isValidString(data.nom, 1, 100) &&
             isValidString(data.email, 3, 254) &&
             isValidString(data.tel, 0, 40) &&
             isValidString(data.adresse, 0, 300) &&
             isValidString(data.updatedAt, 1, 64);
    }

    function isValidCart(data) {
      let allowed = ['items', 'promoCode', 'updatedAt'];
      return hasRequiredFields(data, allowed) &&
             hasOnlyAllowedFields(data, allowed) &&
             isValidMapList(data.items, 50) &&
             isValidString(data.promoCode, 0, 32) &&
             isValidString(data.updatedAt, 1, 64);
    }

    function isValidTickets(data) {
      let allowed = ['items', 'updatedAt'];
      return hasRequiredFields(data, allowed) &&
             hasOnlyAllowedFields(data, allowed) &&
             isValidMapList(data.items, 200) &&
             isValidString(data.updatedAt, 1, 64);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Default-deny all reads and writes across the entire database.
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin role registry: users can check their own admin status; all client writes and listing are denied.
    // Admins are provisioned only server-side / via Firebase Console, never by clients.
    match /admins/{userId} {
      allow get: if isOwner(userId);
      allow list, create, update, delete: if false;
    }

    // Public event catalog: anyone can read/query events; only admins can create, update, or delete.
    match /evenements/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Private user profiles containing PII.
    // Only the authenticated owner (request.auth.uid == userId) can get, create, or update.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow list, delete: if false;
    }

    // Private user shopping cart synchronization.
    // Only the authenticated owner (request.auth.uid == userId) can get, create, or update.
    match /paniers/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidCart(request.resource.data);
      allow update: if isOwner(userId) && isValidCart(request.resource.data);
      allow list, delete: if false;
    }

    // Private user purchased tickets synchronization.
    // Only the authenticated owner (request.auth.uid == userId) can get, create, or update.
    match /billets/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidTickets(request.resource.data);
      allow update: if isOwner(userId) && isValidTickets(request.resource.data);
      allow list, delete: if false;
    }
  }
}
